default_platform(:ios)

KEY_ID      = "3WHS49Y787"
ISSUER_ID   = "17f51aa8-305f-48b3-acbe-fd8ed3dd5fb6"
KEY_PATH    = File.expand_path("~/private_keys/AuthKey_3WHS49Y787.p8")

platform :ios do
  desc "Build and submit to App Store for review"
  lane :build_and_submit do
    api_key = app_store_connect_api_key(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      key_filepath: KEY_PATH,
      duration: 1200,
      in_house: false
    )

    gym(
      workspace: "scribeai.xcworkspace",
      scheme: "scribeai",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        teamID: "7RS696YC75",
        signingStyle: "automatic",
        destination: "upload"
      },
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{KEY_PATH} -authenticationKeyID #{KEY_ID} -authenticationKeyIssuerID #{ISSUER_ID}",
      output_directory: "/tmp/scribeai_build",
      output_name: "scribeai.ipa",
      clean: true
    )

    deliver(
      api_key: api_key,
      app_version: "99.1",
      ipa: "/tmp/scribeai_build/scribeai.ipa",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      key_filepath: KEY_PATH,
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_version: "99.1",
      skip_binary_upload: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false
    )
  end
end
