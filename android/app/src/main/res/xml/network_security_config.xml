<?xml version="1.0" encoding="utf-8"?>
<!-- Release network policy: HTTPS only, system certificate authorities only.
     Every host the app talks to is https (backend, Supabase, failure reporter, legal pages, PaywallKit API, Play).
     Debug builds use src/debug/res/xml/network_security_config.xml instead; keep dev-only relaxations there. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
